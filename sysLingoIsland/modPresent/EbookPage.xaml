<UserControl x:Class="LingoIsland.Present.EbookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">
  <!-- 電子書擷取頁（design ＜III.C.(C)＞，spec#4/#5/#6；#236 頁面整併）：
       最左＝常駐書目清單（單一事實來源，選書即右側跟著換）｜右側子頁籤【內容】（閱讀器）／【獲得】（匯入卡片）以可見性切換、非 TabControl -->
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 主體：最左常駐書目清單｜右側子頁籤＋pane（#236） -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="288" MinWidth="210"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
      </Grid.ColumnDefinitions>

      <!-- 最左：常駐書目清單（原【獲得】左欄書櫃上提；清空書櫃置頂＋主題篩選＋四鍵排序 toggle＋書卡清單；右鍵/Delete 刪、清空） -->
      <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <TextBlock Text="書櫃" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PinkText}" VerticalAlignment="Center"/>
            <Button x:Name="ClearShelfBtn" Content="清空書櫃" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    ToolTip="移除全部藏書與其本機資料夾"/>
          </Grid>
          <!-- 依 theme 篩選（圖文下拉，多媒體主題管理·B；共用 ThemeFilter） -->
          <ComboBox x:Name="BookThemeFilter" Grid.Row="1" Height="26" Margin="0,6,0,4"
                    VerticalContentAlignment="Center" ToolTip="依主題篩選藏書"/>
          <!-- 四鍵排序 toggle 鈕（加入時間/書名/作者/主題；比照影片 #219）：同鈕再點翻方向；作用中＝MDL2 字圖＋▲/▼＋粗體深色（非顏色線索），存 ebooks.json 跨啟動沿用 -->
          <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="EbookSortAddedBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依加入時間排序（新→舊／舊→新）。再點一次切換方向。"/>
            <Button x:Name="EbookSortTitleBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依書名排序（A→Z／Z→A，自然排序）。再點一次切換方向。"/>
            <Button x:Name="EbookSortAuthorBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依作者排序（A→Z／Z→A，自然排序）。再點一次切換方向。"/>
            <Button x:Name="EbookSortThemeBtn" Style="{StaticResource GhostButton}" Margin="0,0,0,2" Padding="6,2"
                    ToolTip="依主題分組排序（主題名正向／反向；未歸屬排最後）。再點一次切換方向。"/>
          </WrapPanel>
          <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
              <ListBox x:Name="BookList" BorderThickness="0" Background="Transparent" Margin="4"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ToolTip="點選書卡；按右鍵可標記主題或刪除，或按 Delete 移除"/>
              <TextBlock x:Name="BookEmptyHint" Foreground="#9A6A82" FontSize="12" TextWrapping="Wrap" MaxWidth="190"
                         TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>

      <GridSplitter Grid.Column="1" Style="{StaticResource ColSplitter}"/>

      <!-- 右側：子頁籤（內容／獲得）＋兩 pane 疊放同格、靠可見性切換（#236） -->
      <Grid Grid.Column="2" Margin="6,0,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 子頁籤（#236 移入右側；預設仍【獲得】——書空先匯入，書目雙擊書卡自動切【內容】） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <RadioButton x:Name="EbookTabContent" Style="{StaticResource SubTab}" GroupName="EbookSubTab" Content="內容"/>
          <RadioButton x:Name="EbookTabAcquire" Style="{StaticResource SubTab}" GroupName="EbookSubTab" IsChecked="True" Content="獲得"/>
        </StackPanel>

        <Grid Grid.Row="1">

        <!-- 【獲得】＝匯入卡片（書櫃已上提至最左常駐欄；AllowDrop 置於整張卡片：拖放範圍＝整個匯入區塊，比照影片 #193） -->
        <Grid x:Name="EbookAcquirePane">
        <Border x:Name="ImportCard" Style="{StaticResource Card}" Padding="12" AllowDrop="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="匯入電子書" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PinkText}" Margin="0,0,0,4"/>
              <TextBlock Text="選擇或拖入本機 .epub 檔（可多檔批次）；僅讀取解析、原檔複本會存到藏書資料夾、不改寫你的原檔。"
                         Foreground="{StaticResource PinkSub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <!-- 拖放區＋選檔鈕：亦可直接把 .epub 拖到整張卡片任一處 -->
              <Border BorderBrush="{StaticResource PinkText}" BorderThickness="1" CornerRadius="6"
                      Background="#33FFFFFF" Padding="10" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="將 .epub 檔拖放到此，或" Foreground="#B692A6" FontSize="11"
                             HorizontalAlignment="Center" Margin="0,0,0,6"/>
                  <Button x:Name="PickEpubBtn" Content="&#x1F4D6; 選擇 EPUB 檔…" Style="{StaticResource GhostButton}"
                          HorizontalAlignment="Center" ToolTip="選擇一個或多個本機 .epub 檔"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 已選檔數＋全部清除 -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
              <TextBlock x:Name="EbookFilesCount" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource PinkText}" VerticalAlignment="Center"/>
              <Button x:Name="EbookClearFilesBtn" Content="全部清除" Style="{StaticResource GhostButton}"
                      HorizontalAlignment="Right" Visibility="Collapsed" ToolTip="清空待匯入清單"/>
            </Grid>

            <!-- 已選檔清單（含逐檔預解析狀態）：最大高度＋垂直捲動（主打整套多本，不靠版面撐開） -->
            <Border x:Name="EbookFilesCard" Grid.Row="2" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="EbookFilesList"/>
              </ScrollViewer>
            </Border>

            <!-- 底列：批次確認鈕（文案隨可匯入檔數變） -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="#8A5A6E" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="匯入前彙總確認：已在書櫃者略過、非 EPUB／壞檔不匯入。"/>
              <Button x:Name="EbookImportBtn" Grid.Column="1" Style="{StaticResource PinkButton}" MinWidth="152" Height="32"
                      VerticalAlignment="Center" Content="&#xFF0B; 匯入電子書"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- 【內容】逐段導讀閱讀器（[EbookPage] 內容閱讀器契約，spec#7–#10；#235 版面整理：移除右逐段清單〔與中閱讀區重複〕、
           章節目錄整併為右欄單一清單、說話人顯示篩選移到場景圖正下方）：
           中＝場景圖＋顯示篩選＋閱讀區（當前段放大高亮＋逐字可點；點段跳讀、右鍵複製/加筆記）＋控制列｜右＝章節清單（點章跳讀）＋說話人勾選面板 -->
      <Grid x:Name="EbookContentPane" Visibility="Collapsed">
        <Border Style="{StaticResource Card}" Padding="8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="240"/>
              <ColumnDefinition Width="6"/>
              <ColumnDefinition Width="248" MinWidth="160"/>
            </Grid.ColumnDefinitions>

            <!-- 中：閱讀區＝場景圖（隨閱讀位置換、增量3）為主＋其下逐段文字（當前段放大高亮、逐字可點）＋控制列 -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition x:Name="ReaderImageRow" Height="0"/>          <!-- 場景圖（增量3）；有圖 1.4*、無圖 0 -->
                <RowDefinition x:Name="ReaderImageSplitterRow" Height="0"/>  <!-- 可拖拉分隔線；有圖 Auto、無圖 0 -->
                <RowDefinition Height="*" MinHeight="140"/>                  <!-- 閱讀內容塊＝顯示篩選列＋閱讀區（#265：須為單一容器，見下） -->
                <RowDefinition Height="Auto"/>                               <!-- 控制列 -->
              </Grid.RowDefinitions>

              <!-- 場景圖（增量3）：前景完整顯示整張（Uniform、不裁切）＋背景模糊填滿留白（UniformToFill＋Blur）；
                   圖塊大小由版面/拖拉決定、跨章固定（見 SetupSceneImageBlock），不隨圖或有無圖跳動；純文字書整塊收起 -->
              <Border x:Name="ReaderSceneImageBox" Grid.Row="0" Background="#22000000" BorderBrush="#F4C2D0" BorderThickness="1"
                      CornerRadius="6" ClipToBounds="True" Visibility="Collapsed">
                <Grid>
                  <Image x:Name="ReaderSceneImageBg" Stretch="UniformToFill">
                    <Image.Effect>
                      <BlurEffect Radius="26" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Image.Effect>
                  </Image>
                  <Image x:Name="ReaderSceneImage" Stretch="Uniform"/>
                </Grid>
              </Border>

              <!-- 可拖拉分隔線：調整場景圖框高度（無圖時 collapse） -->
              <GridSplitter x:Name="ReaderImageSplitter" Grid.Row="1" Height="6" HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" Background="#F4C2D0" ResizeBehavior="PreviousAndNext"
                            ResizeDirection="Rows" Visibility="Collapsed"/>

              <!-- 閱讀內容塊（#265）＝顯示篩選列＋閱讀區，**必須同在一個容器內佔外層單一列**：
                   `ReaderImageSplitter` 之 ResizeBehavior=PreviousAndNext 只認緊鄰前後兩列，若把篩選列直接放外層
                   （#235 原作法）則分隔線的 Next 目標會變成該 Auto 列、被撐成空白帶而閱讀區完全不動。
                   日後若要在閱讀區上方再加任何列，一律加在本內層 Grid 內、不得加回外層。 -->
              <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>              <!-- 說話人顯示篩選 -->
                  <RowDefinition Height="*" MinHeight="96"/>  <!-- 閱讀區 -->
                </Grid.RowDefinitions>

                <!-- 說話人顯示篩選（#235：移到場景圖正下方、貼近作用對象＝下方閱讀區；勾選來源＝右欄說話人面板） -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,6">
                  <TextBlock Text="顯示：" VerticalAlignment="Center" Foreground="{StaticResource PinkText}" Margin="0,0,4,0"/>
                  <ComboBox x:Name="ReaderSpeakerFilter" MinWidth="150" Height="26" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip="如何呈現右側說話人面板勾選的說話人：全部顯示／只顯示他們的段落（章節標題與當前段仍顯示）／只加粗他們／只為他們上色（其餘恢復預設色）。">
                    <ComboBoxItem>全部顯示</ComboBoxItem>
                    <ComboBoxItem>只顯示勾選者</ComboBoxItem>
                    <ComboBoxItem>只加粗勾選者</ComboBoxItem>
                    <ComboBoxItem>只著色勾選者</ComboBoxItem>
                  </ComboBox>
                </StackPanel>

                <Border Grid.Row="1" Background="#66FFFFFF" BorderBrush="#F4C2D0" BorderThickness="1" CornerRadius="6">
                  <ScrollViewer x:Name="ReadingScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                Padding="10,8">
                    <StackPanel x:Name="ReadingPanel"/>
                  </ScrollViewer>
                </Border>
              </Grid>

              <!-- 控制列：主題／語速／上一段／繼續／下一段／朗讀／加入筆記／暫停 -->
              <WrapPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                  <TextBlock Text="主題：" VerticalAlignment="Center" Foreground="{StaticResource PinkText}" Margin="0,0,4,0"/>
                  <ComboBox x:Name="ReaderThemePicker" MinWidth="118" Height="26" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip="顯示／變更此書所屬主題（供說話人依主題色上色）"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,4">
                  <TextBlock Text="語速：" VerticalAlignment="Center" Foreground="{StaticResource PinkText}" Margin="0,0,4,0"/>
                  <ComboBox x:Name="ReaderSpeed" MinWidth="72" Height="26" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip="朗讀語速（50%–150%）"/>
                </StackPanel>
                <Button x:Name="ReaderPrevBtn" Content="&#x23EE; 上一段" Width="90" Height="28" Margin="0,0,6,4" IsEnabled="False"/>
                <Button x:Name="ReaderResumeBtn" Content="&#x25B6; 播放/繼續" Width="108" Height="28" Margin="0,0,6,4" IsEnabled="False"
                        ToolTip="連續朗讀（只念對話段）：唸完自動前進、遇暫停點停、章末停；再按一次暫停。快速鍵 Space。"/>
                <Button x:Name="ReaderNextBtn" Content="&#x23ED; 下一段" Width="84" Height="28" Margin="0,0,6,4" IsEnabled="False"/>
                <Button x:Name="ReaderSpeakBtn" Width="104" Height="28" Margin="0,0,6,4" IsEnabled="False"
                        ToolTip="只朗讀當前這一段一次、不自動前進。">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="ReaderSpeakLabel" Text="朗讀單段" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button x:Name="ReaderAddNoteBtn" Width="120" Height="28" Margin="8,0,0,4" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="加入筆記" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,4">
                  <TextBlock Text="朗讀：" VerticalAlignment="Center" Foreground="{StaticResource PinkText}" Margin="0,0,4,0"/>
                  <ComboBox x:Name="ReaderReadScope" MinWidth="96" Height="26" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip="朗讀範圍（偏好跨啟動記憶）：朗讀對話＝只念有說話人（Name:）的台詞（預設）；讀全部＝連旁白敘述也念（標題不念）。">
                    <ComboBoxItem>朗讀對話</ComboBoxItem>
                    <ComboBoxItem>讀全部</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,4">
                  <TextBlock Text="暫停：" VerticalAlignment="Center" Foreground="{StaticResource PinkText}" Margin="0,0,4,0"/>
                  <ComboBox x:Name="ReaderPauseAtSpeaker" MinWidth="200" Height="26" VerticalContentAlignment="Center"
                            IsEnabled="False" ToolTip="連續朗讀時的暫停方式（偏好跨啟動記憶）：不暫停＝念到章末；發言前暫停＝停在勾選者的段落之前（按繼續才由 App 念這段）；發言後暫停＝念完勾選者的段落即停；暫停並屏蔽＝勾選者的段落不發音、停下換你自己念（角色扮演），按繼續念下一段。前兩者 App 都會念勾選者、屏蔽則不念。">
                    <ComboBoxItem>不暫停</ComboBoxItem>
                    <ComboBoxItem>於指定說話人發言前暫停</ComboBoxItem>
                    <ComboBoxItem>於指定說話人發言後暫停</ComboBoxItem>
                    <ComboBoxItem>暫停並屏蔽指定說話人發言</ComboBoxItem>
                  </ComboBox>
                </StackPanel>
              </WrapPanel>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：章節清單（#235 整併：原左欄章節樹移此、逐段清單移除——跳段＝點閱讀區段落或章節）＋說話人勾選面板 -->
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150" MinHeight="46"/>
              </Grid.RowDefinitions>

              <TextBlock x:Name="ReaderBookTitle" Grid.Row="0" Text="章節" FontWeight="Bold" FontSize="13"
                         Foreground="{StaticResource PinkText}" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                         ToolTip="目前閱讀中的書"/>

              <!-- 章節清單（書名＋多層可收合目錄；點章跳至該章開頭、當前章高亮） -->
              <Border Grid.Row="1" Background="#55FFFFFF" BorderBrush="#F4C2D0" BorderThickness="1" CornerRadius="4">
                <Grid>
                  <TreeView x:Name="ChapterTree" BorderThickness="0" Background="Transparent" Margin="4"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ToolTip="點章節跳至該章開頭；各層可收合／展開"/>
                  <TextBlock x:Name="ReaderEmptyHint" Foreground="#9A6A82" FontSize="12" TextWrapping="Wrap" MaxWidth="170"
                             TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Text="尚未開書。請至「獲得」子頁籤雙擊一本書開始閱讀。"/>
                </Grid>
              </Border>

              <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent"
                            ToolTip="拖曳以調整說話人清單大小"/>

              <!-- 說話人勾選面板（全部說話人＋各說話人+語句數＋無說話人）：篩選/顯示與暫停共用同一份勾選（比照影片頁） -->
              <Border Grid.Row="3" Background="#55FFFFFF" BorderBrush="#F4C2D0" BorderThickness="1" CornerRadius="4">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="說話人（供上方篩選與暫停使用）" Foreground="#B0578D"
                               FontSize="11" Margin="6,3,6,2" TextTrimming="CharacterEllipsis"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="4,0,4,4">
                      <ItemsControl x:Name="ReaderSpeakerChecks">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <!-- #294：右鍵指定該說話人於現用主題之色槽（選單於開啟時依主題動態填入，共用 SpeakerColorMenu） -->
                            <Grid Background="{Binding RowStripe}" ContextMenuOpening="OnSpeakerColorMenuOpening">
                              <Grid.ContextMenu><ContextMenu/></Grid.ContextMenu>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <CheckBox Grid.Column="0" Content="{Binding DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                        FontWeight="{Binding Weight}" FontSize="12" Foreground="{Binding NameBrush}" Margin="4,2" VerticalContentAlignment="Center"/>
                              <Button Grid.Column="1" Content="&#xE70B;" FontFamily="Segoe MDL2 Assets" Foreground="#B0578D"
                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      Width="24" Height="22" Padding="0" FontSize="15" Margin="2,1,6,1"
                                      Visibility="{Binding AddNotesVisibility}" Click="OnAddSpeakerNotesClick"
                                      ToolTip="將此說話人的所有段落原文加入我的筆記（會先確認費用；逐句翻譯）"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- 共用狀態列（兩子頁皆可見）：匯入／解析／刪除訊息不因切子頁而被遮 -->
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="4,6,4,0" FontSize="12" Foreground="{StaticResource PinkText}"
               TextWrapping="Wrap" Text="請於「獲得」子頁籤選擇或拖入 .epub 檔匯入電子書。"/>
  </Grid>
</UserControl>
