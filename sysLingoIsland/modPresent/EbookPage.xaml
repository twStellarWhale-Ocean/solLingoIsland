<UserControl x:Class="LingoIsland.Present.EbookPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Focusable="True">
  <!-- 電子書擷取頁（design ＜III.C.(C)＞，spec#4/#5/#6；比照 VideoCapturePage／ScreenCapturePage 版面族）：
       兩子頁籤【獲得】（左書櫃＋右匯入卡片，本增量焦點）／【內容】（章節閱讀骨架佔位）以可見性切換、非 TabControl -->
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 子頁籤：獲得 / 內容（增量1 焦點＝獲得，故預設選中；內容僅骨架佔位、閱讀朗讀為後續增量） -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton x:Name="EbookTabAcquire" Style="{StaticResource SubTab}" GroupName="EbookSubTab" IsChecked="True" Content="獲得"/>
      <RadioButton x:Name="EbookTabContent" Style="{StaticResource SubTab}" GroupName="EbookSubTab" Content="內容"/>
    </StackPanel>

    <!-- body：兩 pane 疊放同格，靠可見性切換 -->
    <Grid Grid.Row="1">

      <!-- 【獲得】左＝書櫃清單｜右＝匯入卡片 -->
      <Grid x:Name="EbookAcquirePane">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="288" MinWidth="210"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*" MinWidth="260"/>
        </Grid.ColumnDefinitions>

        <!-- 左：書櫃（清空書櫃置頂＋主題篩選＋四鍵排序 toggle＋書卡清單；右鍵/Delete 刪、清空） -->
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0">
            <TextBlock Text="書櫃" FontWeight="Bold" FontSize="13" Foreground="{StaticResource PinkText}" VerticalAlignment="Center"/>
            <Button x:Name="ClearShelfBtn" Content="清空書櫃" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                    ToolTip="移除全部藏書與其本機資料夾"/>
          </Grid>
          <!-- 依 theme 篩選（圖文下拉，多媒體主題管理·B；共用 ThemeFilter） -->
          <ComboBox x:Name="BookThemeFilter" Grid.Row="1" Height="26" Margin="0,6,0,4"
                    VerticalContentAlignment="Center" ToolTip="依主題篩選藏書"/>
          <!-- 四鍵排序 toggle 鈕（加入時間/書名/作者/主題；比照影片 #219）：同鈕再點翻方向；作用中＝MDL2 字圖＋▲/▼＋粗體深色（非顏色線索），存 ebooks.json 跨啟動沿用 -->
          <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="EbookSortAddedBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依加入時間排序（新→舊／舊→新）。再點一次切換方向。"/>
            <Button x:Name="EbookSortTitleBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依書名排序（A→Z／Z→A，自然排序）。再點一次切換方向。"/>
            <Button x:Name="EbookSortAuthorBtn" Style="{StaticResource GhostButton}" Margin="0,0,4,2" Padding="6,2"
                    ToolTip="依作者排序（A→Z／Z→A，自然排序）。再點一次切換方向。"/>
            <Button x:Name="EbookSortThemeBtn" Style="{StaticResource GhostButton}" Margin="0,0,0,2" Padding="6,2"
                    ToolTip="依主題分組排序（主題名正向／反向；未歸屬排最後）。再點一次切換方向。"/>
          </WrapPanel>
          <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
              <ListBox x:Name="BookList" BorderThickness="0" Background="Transparent" Margin="4"
                       HorizontalContentAlignment="Stretch"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ToolTip="點選書卡；按右鍵可標記主題或刪除，或按 Delete 移除"/>
              <TextBlock x:Name="BookEmptyHint" Foreground="#9A6A82" FontSize="12" TextWrapping="Wrap" MaxWidth="190"
                         TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Style="{StaticResource ColSplitter}"/>

        <!-- 右：匯入卡片（AllowDrop 置於整張卡片：拖放範圍＝整個匯入區塊，比照影片 #193） -->
        <Border x:Name="ImportCard" Grid.Column="2" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="12" AllowDrop="True">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="匯入電子書" FontWeight="Bold" FontSize="14" Foreground="{StaticResource PinkText}" Margin="0,0,0,4"/>
              <TextBlock Text="選擇或拖入本機 .epub 檔（可多檔批次）；僅讀取解析、原檔複本會存到藏書資料夾、不改寫你的原檔。"
                         Foreground="{StaticResource PinkSub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <!-- 拖放區＋選檔鈕：亦可直接把 .epub 拖到整張卡片任一處 -->
              <Border BorderBrush="{StaticResource PinkText}" BorderThickness="1" CornerRadius="6"
                      Background="#33FFFFFF" Padding="10" Margin="0,0,0,8">
                <StackPanel HorizontalAlignment="Center">
                  <TextBlock Text="將 .epub 檔拖放到此，或" Foreground="#B692A6" FontSize="11"
                             HorizontalAlignment="Center" Margin="0,0,0,6"/>
                  <Button x:Name="PickEpubBtn" Content="&#x1F4D6; 選擇 EPUB 檔…" Style="{StaticResource GhostButton}"
                          HorizontalAlignment="Center" ToolTip="選擇一個或多個本機 .epub 檔"/>
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- 已選檔數＋全部清除 -->
            <Grid Grid.Row="1" Margin="0,0,0,4">
              <TextBlock x:Name="EbookFilesCount" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource PinkText}" VerticalAlignment="Center"/>
              <Button x:Name="EbookClearFilesBtn" Content="全部清除" Style="{StaticResource GhostButton}"
                      HorizontalAlignment="Right" Visibility="Collapsed" ToolTip="清空待匯入清單"/>
            </Grid>

            <!-- 已選檔清單（含逐檔預解析狀態）：最大高度＋垂直捲動（主打整套多本，不靠版面撐開） -->
            <Border x:Name="EbookFilesCard" Grid.Row="2" Style="{StaticResource Card}" Padding="4" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="EbookFilesList"/>
              </ScrollViewer>
            </Border>

            <!-- 底列：批次確認鈕（文案隨可匯入檔數變） -->
            <Grid Grid.Row="3" Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Foreground="#8A5A6E" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="匯入前彙總確認：已在書櫃者略過、非 EPUB／壞檔不匯入。"/>
              <Button x:Name="EbookImportBtn" Grid.Column="1" Style="{StaticResource PinkButton}" MinWidth="152" Height="32"
                      VerticalAlignment="Center" Content="&#xFF0B; 匯入電子書"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- 【內容】章節閱讀骨架（本增量僅佔位，閱讀／朗讀為後續版本） -->
      <Border x:Name="EbookContentPane" Style="{StaticResource Card}" Visibility="Collapsed" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                     Foreground="{StaticResource PinkAccent}" HorizontalAlignment="Center"/>
          <TextBlock Text="章節閱讀與朗讀將於後續版本推出。" Foreground="{StaticResource PinkText}"
                     FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center"/>
          <TextBlock Text="本版本專注於電子書匯入與書櫃整理，請至「獲得」子頁籤選擇或拖入 EPUB。"
                     Foreground="{StaticResource PinkSub}" FontSize="12" TextWrapping="Wrap"
                     TextAlignment="Center" MaxWidth="360" Margin="0,6,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 共用狀態列（兩子頁皆可見）：匯入／解析／刪除訊息不因切子頁而被遮 -->
    <TextBlock x:Name="StatusText" Grid.Row="2" Margin="4,6,4,0" FontSize="12" Foreground="{StaticResource PinkText}"
               TextWrapping="Wrap" Text="請於「獲得」子頁籤選擇或拖入 .epub 檔匯入電子書。"/>
  </Grid>
</UserControl>
